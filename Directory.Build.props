<Project>
  <PropertyGroup>
    <!-- net8.0 floor so the net8.0 AMLService can consume it; net10.0 services
         (Kefi) reference a net8.0 package with no issue. Do not raise without a
         reason — AML is the lowest-common-denominator consumer. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <Authors>DLoizides</Authors>
    <Company>OnlineMenu</Company>
    <PackageProjectUrl>https://github.com/openmindednewby/Security.SecretProtector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openmindednewby/Security.SecretProtector</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>security;encryption;aes-gcm;secrets;at-rest;protector;multi-tenancy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>AES-256-GCM at-rest secret protector. Encrypts sensitive secrets (API keys, webhook signing secrets, payment credentials) using an authenticated-encryption envelope keyed from configuration. Stored format is base64( nonce(12) + tag(16) + ciphertext ).</Description>

    <!-- Versioning -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- NuGet settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
