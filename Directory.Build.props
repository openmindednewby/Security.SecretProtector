<Project>
  <PropertyGroup>
    <!-- net8.0 floor so the net8.0 AMLService can consume it; net10.0 services
         (Kefi) reference a net8.0 package with no issue. Do not raise without a
         reason â€” AML is the lowest-common-denominator consumer. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <HouseArchitectureStyle>Clean</HouseArchitectureStyle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <Authors>DLoizides</Authors>
    <Company>OnlineMenu</Company>
    <PackageProjectUrl>https://github.com/openmindednewby/Security.SecretProtector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openmindednewby/Security.SecretProtector</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>security;encryption;aes-gcm;secrets;at-rest;protector;multi-tenancy;hkdf;per-tenant;key-rotation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>AES-256-GCM at-rest secret protector. ISecretProtector encrypts sensitive secrets (API keys, webhook signing secrets, payment credentials) with a single configured key. ITenantSecretProtector (1.1.0) adds per-tenant keys derived via HKDF from a versioned master keyring, so one tenant cannot decrypt another's credential, with zero-downtime key rotation. Key material lives only in a secrets manager, never the database.</Description>

    <!-- Versioning -->
    <!-- 1.1.0 — adds ITenantSecretProtector / HkdfTenantSecretProtector (per-tenant HKDF-derived
         keys + versioned zero-downtime rotation) for FINREG's F-10 credential vault. Additive:
         the single-key ISecretProtector surface is unchanged and its tokens are untouched. -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>

    <!-- NuGet settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dloizides.Analyzers" Version="0.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>




